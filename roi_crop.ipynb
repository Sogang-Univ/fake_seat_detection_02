from pynq import Overlay, allocate
import numpy as np
import cv2
import os
import time
import gc


# ============================================================
# 1. 사용자 설정
# ============================================================
BASE_DIR = "/home/ubuntu/work/roi_crop"

BIT_PATH = os.path.join(
    BASE_DIR,
    "design_1_wrapper.bit"
)

INPUT_NPY_PATH = os.path.join(
    BASE_DIR,
    "camera_recordempty.npy"
)

OUTPUT_MP4_PATH = os.path.join(
    BASE_DIR,
    "roi_crop_output_video.mp4"
)

SAVE_OUTPUT_NPY = False

OUTPUT_NPY_PATH = os.path.join(
    BASE_DIR,
    "roi_crop_output_video.npy"
)

# addnpy.py에서 BGR→RGB 변환 후 저장했으므로 RGB가 맞음
INPUT_COLOR_ORDER = "RGB"

OUTPUT_FPS = 30.0

# NumPy shape는 (height, width, channel)
INPUT_SHAPE = (480, 640, 3)
OUTPUT_SHAPE = (480, 480, 3)

INPUT_BYTES = int(np.prod(INPUT_SHAPE))
OUTPUT_BYTES = int(np.prod(OUTPUT_SHAPE))

# 진단 단계에서는 프레임 수를 제한할 수 있음
# 전체 처리: None
MAX_FRAMES = None

# 흰색 입력 프레임을 만나면 중단할지 여부
STOP_ON_ALL_WHITE_INPUT = True

# 출력 전체가 흰색이면 저장하지 않을지 여부
SKIP_ALL_WHITE_OUTPUT = False


# ============================================================
# 2. 입력 색상 순서를 HLS용 RGB로 통일
# ============================================================
def convert_input_to_rgb(frame):
    if frame.dtype != np.uint8:
        frame = np.clip(frame, 0, 255).astype(np.uint8)

    if INPUT_COLOR_ORDER == "RGB":
        rgb_frame = frame
    elif INPUT_COLOR_ORDER == "BGR":
        rgb_frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
    else:
        raise ValueError(
            "INPUT_COLOR_ORDER는 'RGB' 또는 'BGR'이어야 합니다."
        )

    return np.ascontiguousarray(rgb_frame, dtype=np.uint8)


# ============================================================
# 3. HLS 상태 확인
# ============================================================
def read_hls_status(ip):
    ctrl = ip.read(0x00)

    return {
        "raw": ctrl,
        "ap_start": bool(ctrl & (1 << 0)),
        "ap_done": bool(ctrl & (1 << 1)),
        "ap_idle": bool(ctrl & (1 << 2)),
        "ap_ready": bool(ctrl & (1 << 3)),
    }


# ============================================================
# 4. 한 프레임 처리
# ============================================================
def process_one_frame(
    frame_rgb,
    input_buffer,
    output_buffer,
    dma_in,
    dma_out,
    roi_crop_ip
):
    if frame_rgb.shape != INPUT_SHAPE:
        raise ValueError(
            f"입력 shape 오류: {frame_rgb.shape}, "
            f"필요 shape: {INPUT_SHAPE}"
        )

    if frame_rgb.dtype != np.uint8:
        raise TypeError(
            f"입력 dtype 오류: {frame_rgb.dtype}"
        )

    status_before = read_hls_status(roi_crop_ip)

    if not (
        status_before["ap_idle"]
        or status_before["ap_ready"]
        or status_before["ap_done"]
    ):
        raise RuntimeError(
            "HLS IP가 이전 작업을 끝내지 못했습니다.\n"
            f"HLS CTRL = 0x{status_before['raw']:08X}"
        )

    np.copyto(input_buffer, frame_rgb)

    # 미작성 영역 진단용 패턴
    output_buffer[:, :, 0] = 17
    output_buffer[:, :, 1] = 29
    output_buffer[:, :, 2] = 43

    input_buffer.flush()
    output_buffer.flush()

    start_time = time.perf_counter()

    # 반드시 출력 DMA를 먼저 준비
    dma_out.recvchannel.transfer(output_buffer)

    # HLS 시작
    roi_crop_ip.write(0x00, 0x01)

    # 입력 DMA 시작
    dma_in.sendchannel.transfer(input_buffer)

    # 실제 전송 완료까지 대기
    dma_in.sendchannel.wait()
    dma_out.recvchannel.wait()

    output_buffer.invalidate()

    elapsed_ms = (
        time.perf_counter() - start_time
    ) * 1000.0

    result_rgb = np.array(
        output_buffer,
        copy=True
    )

    return result_rgb, elapsed_ms


# ============================================================
# 5. 파일 확인
# ============================================================
print("========== 파일 확인 ==========")

for path in [BIT_PATH, INPUT_NPY_PATH]:
    exists = os.path.isfile(path)
    print(path, ":", exists)

    if not exists:
        raise FileNotFoundError(path)

HWH_PATH = os.path.splitext(BIT_PATH)[0] + ".hwh"

print(HWH_PATH, ":", os.path.isfile(HWH_PATH))

if not os.path.isfile(HWH_PATH):
    raise FileNotFoundError(HWH_PATH)


# ============================================================
# 6. Overlay 로드
# ============================================================
print("\n========== Overlay 로드 ==========")

overlay = Overlay(
    BIT_PATH,
    download=True
)

if not overlay.is_loaded():
    raise RuntimeError("Overlay 로드에 실패했습니다.")

dma_in = overlay.axi_dma_0
dma_out = overlay.axi_dma_1

# 현재 Vivado 블록 디자인의 실제 IP 이름
roi_crop_ip = overlay.roi_crop_top_0

print("Overlay loaded:", overlay.is_loaded())
print("HLS IP:", roi_crop_ip)
print("DMA input max:", dma_in.sendchannel._max_size)
print("DMA output max:", dma_out.recvchannel._max_size)
print("입력 전송 바이트:", INPUT_BYTES)
print("출력 전송 바이트:", OUTPUT_BYTES)

if dma_in.sendchannel._max_size < INPUT_BYTES:
    raise RuntimeError(
        "입력 DMA 최대 크기가 한 프레임보다 작습니다."
    )

if dma_out.recvchannel._max_size < OUTPUT_BYTES:
    raise RuntimeError(
        "출력 DMA 최대 크기가 한 프레임보다 작습니다."
    )


# ============================================================
# 7. 입력 NPY 로드
# ============================================================
print("\n========== 입력 영상 확인 ==========")

camera_data = np.load(
    INPUT_NPY_PATH,
    mmap_mode="r"
)

print("입력 shape:", camera_data.shape)
print("입력 dtype:", camera_data.dtype)

if camera_data.ndim != 4:
    raise ValueError(
        "입력 NPY는 "
        "(frame, height, width, channel) 형식이어야 합니다."
    )

if camera_data.shape[1:] != INPUT_SHAPE:
    raise ValueError(
        f"현재 프레임 shape: {camera_data.shape[1:]}\n"
        f"필요 shape: {INPUT_SHAPE}"
    )

if camera_data.dtype != np.uint8:
    raise TypeError(
        f"입력 dtype이 {camera_data.dtype}입니다. "
        "uint8이어야 합니다."
    )

available_frame_count = int(camera_data.shape[0])

if MAX_FRAMES is None:
    frame_count = available_frame_count
else:
    frame_count = min(
        available_frame_count,
        int(MAX_FRAMES)
    )

print("NPY 전체 프레임 수:", available_frame_count)
print("이번 실행 처리 예정:", frame_count)


# ============================================================
# 8. 출력 MP4 준비
# ============================================================
output_height = OUTPUT_SHAPE[0]
output_width = OUTPUT_SHAPE[1]

writer = cv2.VideoWriter(
    OUTPUT_MP4_PATH,
    cv2.VideoWriter_fourcc(*"mp4v"),
    OUTPUT_FPS,
    (output_width, output_height)
)

if not writer.isOpened():
    raise RuntimeError(
        "MP4 VideoWriter를 열 수 없습니다."
    )

print("\n========== 출력 설정 ==========")
print("출력 해상도:", output_width, "x", output_height)
print("출력 FPS:", OUTPUT_FPS)
print("출력 MP4:", OUTPUT_MP4_PATH)


# ============================================================
# 9. 선택적 NPY 출력 준비
#
# 중간 실패 시 뒤쪽 가짜 프레임이 남지 않도록 임시 파일에 기록한 뒤
# 실제 처리 프레임 수만 최종 NPY로 복사
# ============================================================
output_npy_temp = None
output_npy_temp_path = OUTPUT_NPY_PATH + ".tmp.npy"

if SAVE_OUTPUT_NPY:
    output_npy_temp = np.lib.format.open_memmap(
        output_npy_temp_path,
        mode="w+",
        dtype=np.uint8,
        shape=(frame_count,) + OUTPUT_SHAPE
    )


# ============================================================
# 10. DMA 버퍼 할당
# ============================================================
input_buffer = None
output_buffer = None

processed_count = 0
failed_frame_index = None
white_input_indices = []
white_output_indices = []
frame_times_ms = []

total_start_time = time.perf_counter()


try:
    input_buffer = allocate(
        shape=INPUT_SHAPE,
        dtype=np.uint8
    )

    output_buffer = allocate(
        shape=OUTPUT_SHAPE,
        dtype=np.uint8
    )

    print("\n========== 프레임 처리 시작 ==========")

    for frame_index in range(frame_count):
        input_frame = np.asarray(
            camera_data[frame_index]
        )

        is_all_white_input = bool(
            np.all(input_frame == 255)
        )

        if is_all_white_input:
            white_input_indices.append(
                frame_index
            )

            print(
                f"[WARNING] 입력 frame {frame_index}: "
                "전체가 흰색입니다."
            )

            if STOP_ON_ALL_WHITE_INPUT:
                print(
                    "설정에 따라 흰색 입력 프레임부터 처리를 중단합니다."
                )
                break

        frame_rgb = convert_input_to_rgb(
            input_frame
        )

        try:
            result_rgb, elapsed_ms = process_one_frame(
                frame_rgb,
                input_buffer,
                output_buffer,
                dma_in,
                dma_out,
                roi_crop_ip
            )

        except Exception as error:
            failed_frame_index = frame_index

            print(
                f"\n[ERROR] frame {frame_index} 처리 실패"
            )
            print(repr(error))
            break

        if result_rgb.shape != OUTPUT_SHAPE:
            failed_frame_index = frame_index

            print(
                f"[ERROR] frame {frame_index} "
                f"출력 shape 오류: {result_rgb.shape}"
            )
            break

        # 특수 패턴이 그대로 남았는지 확인
        marker = np.array(
            [17, 29, 43],
            dtype=np.uint8
        )

        untouched_mask = np.all(
            result_rgb == marker,
            axis=2
        )

        untouched_pixel_count = int(
            np.count_nonzero(untouched_mask)
        )

        if untouched_pixel_count > 0:
            failed_frame_index = frame_index

            untouched_rows = np.where(
                np.all(untouched_mask, axis=1)
            )[0]

            print(
                f"[ERROR] frame {frame_index}: "
                f"DMA가 쓰지 않은 픽셀 {untouched_pixel_count}개"
            )

            if len(untouched_rows) > 0:
                print(
                    "완전히 미작성된 행 범위:",
                    int(untouched_rows[0]),
                    "~",
                    int(untouched_rows[-1])
                )

            break

        frame_min = int(result_rgb.min())
        frame_max = int(result_rgb.max())
        frame_mean = float(result_rgb.mean())

        is_all_white_output = bool(
            np.all(result_rgb == 255)
        )

        is_all_black_output = bool(
            np.all(result_rgb == 0)
        )

        if is_all_white_output:
            white_output_indices.append(
                frame_index
            )

            print(
                f"[WARNING] 출력 frame {frame_index}: "
                "전체가 흰색입니다."
            )

            if SKIP_ALL_WHITE_OUTPUT:
                continue

        if is_all_black_output:
            print(
                f"[WARNING] 출력 frame {frame_index}: "
                "전체가 검은색입니다."
            )

        # NPY에는 RGB 상태로 저장
        if output_npy_temp is not None:
            output_npy_temp[
                processed_count
            ] = result_rgb

        # OpenCV VideoWriter는 BGR 사용
        result_bgr = cv2.cvtColor(
            result_rgb,
            cv2.COLOR_RGB2BGR
        )

        writer.write(result_bgr)

        frame_times_ms.append(
            elapsed_ms
        )

        processed_count += 1

        print(
            f"[{frame_index + 1:4d}/{frame_count:4d}] "
            f"{elapsed_ms:8.3f} ms | "
            f"min={frame_min:3d} "
            f"max={frame_max:3d} "
            f"mean={frame_mean:7.2f}"
        )


finally:
    writer.release()

    if output_npy_temp is not None:
        output_npy_temp.flush()
        del output_npy_temp
        output_npy_temp = None

    if input_buffer is not None:
        input_buffer.freebuffer()
        input_buffer = None

    if output_buffer is not None:
        output_buffer.freebuffer()
        output_buffer = None

    gc.collect()

    print("\nDMA 버퍼 및 VideoWriter 해제 완료")


# ============================================================
# 11. 실제 처리 개수만 최종 NPY로 저장
# ============================================================
if SAVE_OUTPUT_NPY:
    if processed_count > 0:
        temp_data = np.load(
            output_npy_temp_path,
            mmap_mode="r"
        )

        final_data = np.lib.format.open_memmap(
            OUTPUT_NPY_PATH,
            mode="w+",
            dtype=np.uint8,
            shape=(processed_count,) + OUTPUT_SHAPE
        )

        final_data[:] = temp_data[:processed_count]
        final_data.flush()

        del final_data
        del temp_data

    if os.path.exists(output_npy_temp_path):
        os.remove(output_npy_temp_path)


# ============================================================
# 12. 결과 출력
# ============================================================
total_elapsed_sec = (
    time.perf_counter() - total_start_time
)

print("\n========== 처리 결과 ==========")
print("입력 전체 프레임 수:", available_frame_count)
print("처리 예정 프레임 수:", frame_count)
print("실제 저장 프레임 수:", processed_count)

if failed_frame_index is not None:
    print("처리 실패 프레임:", failed_frame_index)

print("MP4 출력 해상도:", output_width, "x", output_height)
print("MP4 저장 경로:", OUTPUT_MP4_PATH)

if SAVE_OUTPUT_NPY:
    print("NPY 저장 경로:", OUTPUT_NPY_PATH)

print("완전 흰색 입력 프레임 수:", len(white_input_indices))
print("완전 흰색 출력 프레임 수:", len(white_output_indices))

if processed_count == 0:
    raise RuntimeError(
        "정상적으로 저장된 프레임이 없습니다."
    )

average_hardware_ms = float(
    np.mean(frame_times_ms)
)

hardware_fps = (
    1000.0 / average_hardware_ms
)

system_fps = (
    processed_count / total_elapsed_sec
)

print("평균 DMA+HLS 시간:", average_hardware_ms, "ms/frame")
print("DMA+HLS 처리 FPS:", hardware_fps)
print("전체 시스템 FPS:", system_fps)
